<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/enabledCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:contentDescription="@string/content_desc_enabled_row" />

    <ir.hanzodev1375.components.input.TextInputGlass
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp">

        <ir.hanzodev1375.components.input.TextInputEditTextGlass
            android:id="@+id/keyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:hint="@string/hint_key"
            android:textSize="14sp"
            android:maxLines="1"
            android:inputType="text"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:importantForAutofill="no" />
    </ir.hanzodev1375.components.input.TextInputGlass>

    <ir.hanzodev1375.components.input.TextInputGlass
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="4dp">

        <ir.hanzodev1375.components.input.TextInputEditTextGlass
            android:id="@+id/valueInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:hint="@string/hint_value"
            android:textSize="14sp"
            android:maxLines="1"
            android:inputType="text"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:importantForAutofill="no" />
    </ir.hanzodev1375.components.input.TextInputGlass>

    <ImageButton
        android:id="@+id/deleteButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        android:tint="?attr/colorOnSurfaceVariant"
        android:contentDescription="@string/content_desc_delete_row"
        android:padding="8dp" />

</LinearLayout>
